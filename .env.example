# Copy to .env and fill in what you need. .env is git-ignored.
# Real environment variables take precedence over values in this file.

# Which sources to run (comma separated, or "all")
# SCRAPE_SOURCES=all

# Google Drive API key
GOOGLE_API_KEY=
# Pixeldrain API key (optional)
PIXELDRAIN_API_KEY=
# Browser session cookie for kknow.cc searches (optional)
KKNOW_COOKIE=

# Dropbox: refresh token + app key/secret (recommended), or just an access token
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_ACCESS_TOKEN=
